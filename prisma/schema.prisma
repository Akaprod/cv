generator client {
  provider = "prisma-client-js"
}

// ─── Base de données : MySQL Hostinger ──────────────────────────────────────
// PROVIDER = MYSQL (base u398373271_NovaCV créée dans hPanel).
// DATABASE_URL (dans .env SUR LE SERVEUR, jamais commité) :
//   mysql://UTILISATEUR:MOT_DE_PASSE@localhost:3306/NOM_BD
// ⚠️ Les caractères spéciaux du mot de passe doivent être encodés URL
//    (ex. '+' → %2B, '@' → %40).
// SQLite reste utilisé en développement (voir schéma de l'environnement dev) :
//   DATABASE_URL="file:../db/custom.db" avec provider "sqlite".

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── Utilisateurs ────────────────────────────────────────────────────────────
model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String   @db.VarChar(255)
  username      String   @unique // pseudo pour le lien public /@username
  plan          String   @default("FREE") // FREE | PRO
  locale        String   @default("fr") // langue de l'interface : fr en es de it
  aiUsed        Int      @default(0) // crédits IA consommés ce mois
  aiMonth       String? // ex: "2026-10"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  sessions      Session[]
  resumes       Resume[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// ─── CV ──────────────────────────────────────────────────────────────────────
model Resume {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String   @default("Mon CV")
  template  String   @default("moderne") // moderne | classique | compact | elegant | minimal
  accent    String   @default("#047857") // couleur d'accent (hex)
  sector    String?  // branche sectorielle d'origine (slug) : 'hse', 'tech'… null = général
  isPublic  Boolean  @default(true) // lien /@pseudo actif ou non
  views     Int      @default(0)
  locale    String   @default("fr") // langue du contenu du CV (IA + page publique)
  data      String   @default("{}") @db.Text // JSON : ResumeData (peut dépasser 191 car.)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  viewLogs  ViewLog[]

  @@index([sector])
}

model ViewLog {
  id        String   @id @default(cuid())
  resumeId  String
  resume    Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  referrer  String?  @db.Text // URLs UTM potentiellement longues
  createdAt DateTime @default(now())
}
