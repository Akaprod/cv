# ── Base de données ──────────────────────────────────────────────────────────
# Développement (SQLite) :
DATABASE_URL="file:../db/custom.db"
# Production Hostinger (MySQL) — voir deploy/env.production :
# DATABASE_URL="mysql://UTILISATEUR:MOT_DE_PASSE@localhost:3306/NOM_BD"

# ── IA ──────────────────────────────────────────────────────────────────────
# L'app utilise z-ai-web-dev-sdk (clé gérée par l'environnement d'exécution).
# Si vous branchez votre propre provider IA (OpenAI, Mistral, vLLM…), ajoutez
# ici votre clé et adaptez src/app/api/ai/generate/route.ts.
# AI_API_KEY=""

# ── Stripe (Phase 3 — voir commentaires dans src/app/api/billing/upgrade/route.ts)
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
# STRIPE_PRICE_MONTHLY=""
# STRIPE_PRICE_YEARLY=""
