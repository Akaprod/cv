# ── Environnement de PRODUCTION (Hostinger VPS) ─────────────────────────────
# Copier ce fichier à la racine du projet sur le serveur :  cp deploy/env.production .env

# Base de données SQLite (aucun secret) — le dossier db/ doit rester persistant
DATABASE_URL="file:../db/custom.db"

# Node en mode production (active aussi le cookie de session `secure`)
NODE_ENV=production

# Port d'écoute du serveur Next standalone (derrière Nginx)
PORT=3000
HOSTNAME=127.0.0.1

# ── IA ──────────────────────────────────────────────────────────────────────
# La route src/app/api/ai/generate/route.ts utilise z-ai-web-dev-sdk.
# Sur votre propre serveur, remplacez cet appel par votre provider IA
# (OpenAI, Mistral, vLLM auto-hébergé…) et mettez la clé ici :
# AI_API_KEY=""
# AI_BASE_URL=""

# ── Stripe (Phase 3) ────────────────────────────────────────────────────────
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
# STRIPE_PRICE_MONTHLY=""
# STRIPE_PRICE_YEARLY=""
